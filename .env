# This file defines environment variables for Docker-compose (DApp infra)
# and shell scripts. Blockchain runs on Kubernetes.

# Besu Docker image version (used by block-explorer build)
BESU_VERSION=latest
SAMPLE_VERSION=$BESU_VERSION
SAMPLE_POA_NAME=ibft2
LOCK_FILE=.sampleNetworks.lock

# Kubernetes namespace where blockchain runs
K8S_NAMESPACE=tfg

# Path to your node keys (update this to match your machine)
KEYS_PATH=/home/oscar-214/Documents/BESU/besu-25.9.0/bin/IBFT-NW/keys

# Kubernetes manifests directory
K8S_DIR=TFG_INFO_Blockchain/KUBERNETES

